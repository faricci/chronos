coinbase:
  base_url: "https://api.coinbase.com" 
  name: "",
  privateKey: ""

coinbase_sandbox:
  base_url: "https://api-sandbox.coinbase.com"
  name: "",
  privateKey: ""

trading:
  products:
    - "BTC-USD"
    - "ETH-USD"
