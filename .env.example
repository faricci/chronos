# Copia questo file in ".env" (stessa cartella) e compila i valori. ".env" e' ignorato da git.
# Chiave CDP di Coinbase: in dry-run / sviluppo solo permesso View (sola lettura).
COINBASE_API_KEY=organizations/XXXX/apiKeys/YYYY
# La chiave privata PEM su UNA riga, con i ritorni a capo scritti come \n
COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\nXXXX\n-----END EC PRIVATE KEY-----\n"
